# Copier en .env (jamais commité) et remplir.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
COLOC_SECRET_KEY=change-me
# true dès que le site est servi en HTTPS (derrière un reverse proxy) ; false pour tester en local en http
COLOC_COOKIE_SECURE=true
# Port publié sur 127.0.0.1 de l'hôte (doit être libre : ss -ltn | grep :8321)
COLOC_PORT=8321
